{
  "id": "simpleedit.tasks",
  "name": { "en": "Tasks", "fr": "Tâches" },
  "version": "1.0.1",
  "api": 1,
  "description": {
    "en": "Build, test and run the commands of a project (Cargo, npm, Make, Go, tasks.json) with their output and errors",
    "fr": "Compiler, tester et lancer les commandes d'un projet (Cargo, npm, Make, Go, tasks.json) avec leur sortie et leurs erreurs"
  },
  "author": "Ardoise Editor",
  "repository": "ardoise-editor/plugin-tasks",
  "license": "MIT",
  "command": ["bin/tasks"],
  "events": ["active_file"],
  "contributes": {
    "commands": [
      { "id": "tasks.run", "title": { "en": "Tasks: Run…", "fr": "Tâches : lancer…" } },
      { "id": "tasks.rerun", "title": { "en": "Tasks: Run Again", "fr": "Tâches : relancer" } },
      { "id": "tasks.stop", "title": { "en": "Tasks: Stop", "fr": "Tâches : arrêter" } }
    ],
    "panels": [
      { "id": "tasks", "title": { "en": "Tasks", "fr": "Tâches" }, "icon": "", "location": "bottom" }
    ]
  }
}
